
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogado() {
      return request.auth != null;
    }

    function uidAtual() {
      return request.auth.uid;
    }

    function ehDono(userId) {
      return estaLogado() && uidAtual() == userId;
    }

    function ehAdmin() {
      return estaLogado() && (
        request.auth.token.admin == true ||
        (
          // Compatibilidade temporaria enquanto administradores existentes
          // migram para a custom claim `admin`.
          exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true ||
            get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin' ||
            get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipo == 'admin' ||
            get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil == 'admin'
          )
        )
      );
    }

    // Campos que concedem ou representam acesso privilegiado nao podem ser
    // promovidos pelo proprio cliente. Administradores continuam podendo
    // gerenciar perfis legados ate a migracao para Firebase Custom Claims.
    function cadastroUsuarioSemPrivilegiosAdmin() {
      return request.resource.data.get('isAdmin', false) != true &&
             request.resource.data.get('role', '') != 'admin' &&
             request.resource.data.get('tipo', '') != 'admin' &&
             request.resource.data.get('perfil', '') != 'admin';
    }

    function camposDeAutorizacaoInalterados() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'isAdmin',
        'role',
        'tipo',
        'perfil'
      ]);
    }

    function participaDoDocumentoFinanceiro(data) {
      return estaLogado() && data != null && (
        data.clienteId == uidAtual() ||
        data.profissionalId == uidAtual() ||
        data.clinicaId == uidAtual() ||
        data.colaboradorId == uidAtual() ||
        data.usuarioId == uidAtual() ||
        data.ownerId == uidAtual() ||
        data.userId == uidAtual() ||
        ehAdmin()
      );
    }

    match /usuarios/{userId} {
      // Perfis deixam de ser publicos. A verificacao de duplicidade anterior ao
      // cadastro e feita pela Cloud Function, sem expor documentos completos.
      // A leitura autenticada sera refinada por perfil nos proximos itens.
      allow read: if estaLogado();
      // Permitir criação: qualquer usuário autenticado
      // O cliente so pode criar o proprio perfil e nao pode nascer com
      // privilegios administrativos. Escritas do Admin SDK ignoram as rules.
      allow create: if ehDono(userId) && cadastroUsuarioSemPrivilegiosAdmin();
      // O proprio usuario pode editar dados comuns, mas nao os campos que
      // determinam seu perfil/permissao.
      allow update: if ehAdmin() || (
        ehDono(userId) && camposDeAutorizacaoInalterados()
      );
      // Permitir delete se: admin, dono da conta, ou qualquer usuario autenticado (para colaboradores)
      allow delete: if ehAdmin() || ehDono(userId);

      match /notificacoes/{notificacaoId} {
        // Permitir leitura para qualquer usuário autenticado (suporta colaboradores com login anônimo)
        allow read: if ehDono(userId) || ehAdmin();
        // Criar notificações permitido para qualquer usuário logado
        allow create: if estaLogado();
        // Atualizar/deletar apenas pelo dono ou admin
        allow update: if ehDono(userId) || ehAdmin();
        allow delete: if ehDono(userId) || ehAdmin();
      }

      match /favoritos/{favoritoId} {
        allow read, write: if ehDono(userId);
      }

      match /servicos/{servicoId} {
        allow read: if request.auth != null;
        allow write: if ehDono(userId) || ehAdmin();
      }

      match /configuracoes/{configId} {
        allow read: if ehDono(userId) || (estaLogado() && configId == "agenda") || ehAdmin();
        allow write: if ehDono(userId) || ehAdmin();
      }

      match /campanhas/{campanhaId} {
        allow read: if estaLogado();
        allow write: if ehAdmin();
      }

      match /campanhasEmail/{campanhaId} {
        allow read: if estaLogado();
        allow write: if ehAdmin();
      }

      match /colaboradores/{colabId} {
        allow read: if estaLogado();
        allow write: if ehDono(userId);

        match /configuracoes/{configId} {
          // Leitura: gestor (dono), próprio colaborador, ou admin
          allow read: if ehDono(userId) || uidAtual() == colabId || (estaLogado() && configId == "agenda") || ehAdmin();
          allow write: if ehDono(userId) || uidAtual() == colabId || ehAdmin();
        }
      }

      match /avaliacoes/{avaliacaoId} {
        allow read: if true;
        allow create: if estaLogado();
        allow update: if ehDono(userId);
        allow delete: if ehDono(userId);
      }

      match /menores/{menorId} {
        allow read, write: if ehDono(userId);
      }
    }

    // ✅ CORREÇÃO 2: Avaliações na coleção raiz
    // AvaliarAtendimento.js grava em /avaliacoes/{id} (raiz), não em subcoleção.
    // Sem esta regra, a leitura caía no bloqueio geral e gerava o erro de permissão.
    match /avaliacoes/{avaliacaoId} {
      allow read: if true;
      allow create: if estaLogado();
      allow update: if estaLogado() && resource.data.clienteId == uidAtual();
      allow delete: if false;
    }

    // Configurações do sistema - permitir leitura para qualquer usuário autenticado
    match /configuracoes/{configId} {
      allow read: if estaLogado();
      allow write: if ehAdmin();
    }

    match /categorias/{categoriaId} {
      allow read: if true;
      allow create: if estaLogado();
      allow update, delete: if ehAdmin();
    }

    match /agendamentos/{agendamentoId} {
      // Permitir leitura se usuário autenticado (a query já filtra por clinicaId/profissionalId)
      allow read: if participaDoDocumentoFinanceiro(resource.data);
      allow create: if participaDoDocumentoFinanceiro(request.resource.data);
      allow update: if estaLogado() && participaDoDocumentoFinanceiro(resource.data);
      allow delete: if false;
    }

     // NOVAS COLEÇÕES - Planos e Contratos Recorrentes
    match /planosRecorrentes/{planoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.profissionalId == request.auth.uid;
      allow update, delete: if request.auth != null && 
        resource.data.profissionalId == request.auth.uid;
    }

    match /contratosRecorrentes/{contratoId} {
      // Permitir leitura para usuários autenticados - a query filtra por profissionalId ou clienteId
      allow read: if request.auth != null && (
        resource.data.profissionalId == request.auth.uid ||
        resource.data.clienteId == request.auth.uid ||
        ehAdmin()
      );
      allow create: if request.auth != null &&
        request.resource.data.clienteId == request.auth.uid;
      // Para update/delete, verificar se é profissional ou cliente do contrato
      allow update: if request.auth != null && (
        (resource.data.profissionalId == request.auth.uid || resource.data.clienteId == request.auth.uid) ||
        (request.resource.data.profissionalId == request.auth.uid || request.resource.data.clienteId == request.auth.uid)
      );
      allow delete: if request.auth != null && (
        resource.data.profissionalId == request.auth.uid ||
        resource.data.clienteId == request.auth.uid
      );
    }

    // ✅ CORREÇÃO 1: Pagamentos — permite leitura quando documento ainda não existe.
    // buscarCobrancaPorAgendamento() faz getDoc antes de criar a cobrança.
    // A regra anterior bloqueava porque resource.data era null (doc inexistente).
    match /pagamentos/{pagamentoId} {
      allow read: if estaLogado() && (
        !exists(/databases/$(database)/documents/pagamentos/$(pagamentoId)) ||
        participaDoDocumentoFinanceiro(resource.data)
      );
      allow create: if participaDoDocumentoFinanceiro(request.resource.data);
      allow update: if estaLogado() && (
        participaDoDocumentoFinanceiro(resource.data) ||
        participaDoDocumentoFinanceiro(request.resource.data)
      );
      allow delete: if false;
    }

    match /cobrancas/{cobrancaId} {
      allow read: if participaDoDocumentoFinanceiro(resource.data);
      allow create: if participaDoDocumentoFinanceiro(request.resource.data);
      allow update: if
        participaDoDocumentoFinanceiro(resource.data) ||
        participaDoDocumentoFinanceiro(request.resource.data);
      allow delete: if false;
    }

    match /saques/{saqueId} {
      allow read: if participaDoDocumentoFinanceiro(resource.data);
      allow create: if estaLogado() && (
        request.resource.data.userId == uidAtual() ||
        request.resource.data.profissionalId == uidAtual() ||
        ehAdmin()
      );
      allow update: if participaDoDocumentoFinanceiro(resource.data) || ehAdmin();
      allow delete: if false;
    }

    match /saldos/{saldoId} {
      allow read: if ehDono(saldoId) || ehAdmin();
      allow create: if ehDono(saldoId) || ehAdmin();
      allow update: if
        ehDono(saldoId) ||
        participaDoDocumentoFinanceiro(resource.data) ||
        participaDoDocumentoFinanceiro(request.resource.data) ||
        ehAdmin();
      // Permitir delete para qualquer autenticado (simplificado)
      allow delete: if ehDono(saldoId) || ehAdmin();
    }

    // ============================================================
    // COLEÇÃO COLABORADORES (nível raiz) - Criada pelo web
    // ============================================================
    match /colaboradores/{colabId} {
      // Permitir leitura: qualquer usuário autenticado (necessário para login por email)
      allow read: if estaLogado();
      
      // Permitir criação: qualquer usuário logado (gestor cria colaborador)
      // O gestor é identificado pelo profissionalId no documento
      allow create: if estaLogado() && (
        request.resource.data.profissionalId == uidAtual() ||
        ehAdmin()
      );
      
      // Permitir atualização: gestor (profissionalId), próprio colaborador, ou admin
      allow update: if estaLogado() && (
        uidAtual() == colabId ||
        resource.data.profissionalId == uidAtual() ||
        request.resource.data.profissionalId == uidAtual() ||
        ehAdmin()
      );
      
      // Permitir delete: gestor (profissionalId) ou admin
      allow delete: if estaLogado() && (
        resource.data.profissionalId == uidAtual() ||
        ehAdmin()
      );
    }

    // SUPORTE — Regras para tickets e mensagens
    match /suporte/{ticketId} {
      // Se ticketId for o UID do usuário, permite tudo (estilo antigo/simples)
      // Se não, verifica o campo usuarioId no documento (estilo novo)
      allow read: if estaLogado() && (
        ticketId == uidAtual() || 
        ehAdmin() ||
        (resource.data.usuarioId == uidAtual())
      );
      allow create: if estaLogado() && (
        ticketId == uidAtual() || 
        request.resource.data.usuarioId == uidAtual()
      );
      allow update: if estaLogado() && (
        ticketId == uidAtual() || 
        ehAdmin() ||
        resource.data.usuarioId == uidAtual()
      );
      allow delete: if ehAdmin();

      match /mensagens/{msgId} {
        // Permite ler/escrever se ticketId é o UID do usuário (estilo antigo)
        // Ou se o campo usuarioId no documento pai pertence ao usuário
        // Se documento não existe, permite se ticketId == uid (usuário criando próprio ticket)
        allow read, write: if estaLogado() && (
          ticketId == uidAtual() || 
          ehAdmin() ||
          (!exists(/databases/$(database)/documents/suporte/$(ticketId)) && ticketId == uidAtual()) ||
          get(/databases/$(database)/documents/suporte/$(ticketId)).data.usuarioId == uidAtual()
        );
      }
    }

    match /agenda_ocupada/{slotId} {
      allow read: if estaLogado();
      allow create: if estaLogado();
      allow delete: if estaLogado();
      allow update: if false;
    }

    // Transações financeiras — usada pela página Financeiro (web/desktop)
    // Leitura: autenticado (a query filtra por profissionalId)
    // Escrita: só o profissional dono da transação
    match /transacoes/{transacaoId} {
      allow read: if estaLogado() && (
        resource.data.profissionalId == uidAtual() || ehAdmin()
      );
      allow create: if estaLogado()
        && request.resource.data.profissionalId == uidAtual();
      allow update, delete: if estaLogado()
        && resource.data.profissionalId == uidAtual();
    }

    // Colaboradores (coleção raiz) — usada pela versão web/desktop
    // A versão mobile usa subcoleção /usuarios/{id}/colaboradores (regra já existe acima)
    match /colaboradores/{colabId} {
      // Leitura: qualquer autenticado
      allow read: if estaLogado();
      // Criação/Update/Delete: qualquer autenticado (dados protegidos por query no app)
      // Regra duplicada legada neutralizada; prevalecem as regras de ownership
      // da declaracao principal de /colaboradores acima.
      allow create, update, delete: if false;
    }

    // ✅ ASSINATURAS — Coleção para assinaturas VIP (backend Asaas)
    match /assinaturas/{assinaturaId} {
      // Leitura: usuário vê suas próprias assinaturas OU admin vê todas
      allow read: if estaLogado() && (
        resource.data.userId == uidAtual() || ehAdmin()
      );
      // Criação/Update: só backend (webhook) ou admin
      allow create, update: if estaLogado() && (
        request.resource.data.userId == uidAtual() || ehAdmin()
      );
      allow delete: if ehAdmin();
    }

    // ✅ WEBHOOK LOGS — Logs de comunicação com Asaas (debug/monitoramento)
    match /webhookLogs/{logId} {
      // Leitura: apenas admin pode ver logs de webhooks
      allow read: if ehAdmin();
      // Criação: backend pode criar logs
      allow create: if ehAdmin();
      allow update, delete: if ehAdmin();
    }

    // ✅ ACTIVITY LOGS — Logs de atividades dos usuários (monitoramento em tempo real)
    match /activityLogs/{logId} {
      // Leitura: admin pode ler TUDO; usuário comum pode ler apenas SEUS logs
      allow read: if ehAdmin() || (estaLogado() && resource.data.userId == uidAtual());
      // Criação: qualquer usuário logado pode criar log (o app garante que é do próprio user)
      allow create: if estaLogado() &&
        request.resource.data.userId == uidAtual();
      // Update/Delete: apenas admin
      allow update, delete: if ehAdmin();
    }

    // ✅ EQUIPE ADMIN — Gestão de equipe administrativa
    match /equipeAdmin/{membroId} {
      // Todos autenticados podem LER (para relatórios, etc)
      // Apenas admin pode CRIAR/EDITAR/DELETAR
      allow read: if estaLogado();
      allow create: if ehAdmin();
      allow update: if ehAdmin();
      allow delete: if ehAdmin();
    }

    // ✅ ANUNCIOS — Sistema de anúncios patrocinados
    match /anuncios/{anuncioId} {
      // Admin gerencia tudo
      allow read: if ehAdmin() || (
        estaLogado() && resource.data.status == 'ativo'
      );
    }
    
    // ✅ CAMPANHAS — Campanhas de marketing
    match /campanhas/{campanhaId} {
      allow read: if estaLogado();
      allow write: if ehAdmin();
    }
    
    // ✅ CAMPANHAS EMAIL — Campanhas de email marketing
    match /campanhasEmail/{campanhaId} {
      allow read: if estaLogado();
      allow write: if ehAdmin();
      allow create: if ehAdmin();
      allow update: if ehAdmin() || (
        estaLogado() && 
        resource.data.anuncianteId == uidAtual()
      );
      allow delete: if ehAdmin();
    }

    // ✅ CONFIGURACOES — Configurações do sistema
    // Todos usuários logados podem LER (nome da plataforma, taxas, etc)
    // Apenas admin pode ESCREVER
    match /configuracoes/{configId} {
      allow read: if estaLogado();
      allow write: if estaLogado() && ehAdmin();
    }

    // ✅ ANUNCIANTES — Empresas anunciantes
    match /anunciantes/{anuncianteId} {
      allow read: if ehAdmin() || (
        estaLogado() && anuncianteId == uidAtual()
      );
      allow create: if estaLogado(); // Qualquer um pode se cadastrar
      allow update: if ehAdmin() || (
        estaLogado() && anuncianteId == uidAtual()
      );
      allow delete: if ehAdmin();
    }

    // ✅ IMPRESSOES ANUNCIOS — Tracking (qualquer usuário logado pode registrar)
    match /impressoesAnuncios/{impressaoId} {
      allow read: if estaLogado();
      allow create: if estaLogado();
      allow update, delete: if false;
    }

    // ✅ CLIQUES ANUNCIOS — Tracking (qualquer usuário logado pode registrar)
    match /cliquesAnuncios/{cliqueId} {
      allow read: if estaLogado();
      allow create: if estaLogado();
      allow update, delete: if false;
    }

    // Coleção contadores - usada para contadores do sistema (ex: número de profissionais)
    // Permite leitura/escrita para qualquer usuário autenticado (necessário para geração de ID sequencial no cadastro)
    match /config/{configId} {
      allow read, write: if estaLogado();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
