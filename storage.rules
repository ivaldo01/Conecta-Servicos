rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // O codigo atual envia imagens e anexos ao Cloudinary e nao utiliza o
    // Firebase Storage. Mantemos o bucket fechado ate existir um fluxo com
    // caminhos, ownership, MIME type e tamanho explicitamente definidos.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
